# --- Database (Supabase, EU region — e.g. eu-north-1 Stockholm) ---
DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-eu-north-1.pooler.supabase.com:6543/postgres

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI providers ---
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=

# Optional model overrides (defaults in lib/ai/models.ts)
# TRANSCRIPTION_MODEL=gemini-3.5-flash
# EXTRACTION_MODEL=gemini-3.1-pro-preview
# GRADING_MODEL=claude-sonnet-5-5
# SECOND_OPINION_MODEL=gemini-3.5-flash
# EMBEDDING_MODEL=gemini-embedding-001
# DUAL_GRADING=risk                    # off | risk | all

# --- Inngest (queue workers; EU data region available) ---
# Leave empty in local dev (`npm run inngest` runs the dev server).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# INNGEST_BASE_URL=https://api.eu.inngest.com   # EU region

# --- Google Classroom roster sync (OAuth 2.0 web client) ---
GOOGLE_CLASSROOM_CLIENT_ID=
GOOGLE_CLASSROOM_CLIENT_SECRET=
# Redirect URI to register: <APP_URL>/api/integrations/google/callback

# --- Microsoft Teams roster sync (Entra ID app registration) ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=organizations
# Redirect URI to register: <APP_URL>/api/integrations/microsoft/callback

# --- SS 12000 roster import (Skolon / municipal hubs; per-huvudman deploy) ---
# SS12000_BASE_URL=https://api.<hub>/ss12000v2-api/source/<customer>/v2.0
# SS12000_TOKEN=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Secret pepper for hashing portal share codes (any long random string)
SHARE_CODE_PEPPER=
# Column-level encryption key for stored OAuth tokens (any long random string)
TOKEN_ENCRYPTION_KEY=
# Audit-log retention in days (nightly pruning via Inngest cron; default 365)
# AUDIT_RETENTION_DAYS=365
